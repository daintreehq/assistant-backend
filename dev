#!/usr/bin/env bash
#
# Run the Daintree Assistant Server locally.
#
#   ./dev
#
# Everything comes from .env, which this script EXPORTS into the environment
# before starting the server.
set -euo pipefail

# Resolve the repo root (this script's own directory) so ./dev works from anywhere.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

# Interpreter: prefer the project venv, then a system 3.12, then whatever python3.
if [[ -x "$ROOT/.venv/bin/python" ]]; then
  PY="$ROOT/.venv/bin/python"
elif command -v python3.12 >/dev/null 2>&1; then
  PY="python3.12"
else
  PY="python3"
fi

# Load .env into the ENVIRONMENT, not just into pydantic-settings.
#
# `Settings` reads .env by itself, so this is not what makes the server work — it
# is what makes everything ELSE in this shell agree with the server: a `curl`
# typed in the same terminal, a benchmark launched beside it, an inherited
# subprocess. Without it the config the server holds and the config the operator
# can see are two different things, which is exactly the confusion this script
# exists to prevent.
#
# `set -a` exports every assignment; existing environment values are overwritten
# by .env deliberately, so what the file says is what runs.
if [[ -f "$ROOT/.env" ]]; then
  set -a
  # shellcheck disable=SC1091  # runtime file, not present at lint time
  source "$ROOT/.env"
  set +a
fi

# Friendly heads-up: the server always boots, but /readyz stays 503 without the
# two required secrets. CEREBRAS_API_KEY is one of them — the SERVER holds the
# upstream credential and funds every turn from it, so a request no longer brings
# its own key and there is nothing to fall back on if this is missing.
missing=()
[[ -z "${STATE_SIGNING_KEY_CURRENT:-}" ]] && missing+=("STATE_SIGNING_KEY_CURRENT")
[[ -z "${CEREBRAS_API_KEY:-}" ]] && missing+=("CEREBRAS_API_KEY")
if (( ${#missing[@]} )); then
  echo "⚠  Missing: ${missing[*]} — server will boot but /readyz will be 503." >&2
  [[ -f "$ROOT/.env" ]] || echo "   Run:  cp .env.example .env   then fill them in." >&2
fi

# Human-readable structured logs in dev so per-round timing lines (`respond`,
# `respond_upstream_open` → selector_ms / upstream_first_event_ms) are legible in
# the terminal instead of raw JSON. Export-only; unset it or set LOG_LEVEL=WARNING
# in .env to quiet things down.
export DAINTREE_LOG_CONSOLE="${DAINTREE_LOG_CONSOLE:-1}"

echo "▶ Daintree Assistant Server"
echo "  python: $PY   logs: console (DAINTREE_LOG_CONSOLE=$DAINTREE_LOG_CONSOLE)"
# Presence only — never the value.
echo "  upstream: cerebras   key: $([[ -n "${CEREBRAS_API_KEY:-}" ]] && echo set || echo MISSING)"

exec "$PY" -m daintree_assistant_server

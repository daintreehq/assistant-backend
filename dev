#!/usr/bin/env bash
#
# Run the runbook search server locally.
#
#   ./dev
#
# Settings come from .env (see .env.example), which this script EXPORTS so a
# curl in the same terminal agrees with the server about the port.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

# Interpreter: prefer the project venv, then a system 3.12, then whatever python3.
if [[ -x "$ROOT/.venv/bin/python" ]]; then
  PY="$ROOT/.venv/bin/python"
elif command -v python3.12 >/dev/null 2>&1; then
  PY="python3.12"
else
  PY="python3"
fi

if [[ -f "$ROOT/.env" ]]; then
  set -a
  # shellcheck disable=SC1091  # runtime file, not present at lint time
  source "$ROOT/.env"
  set +a
fi

# Human-readable structured logs in dev.
export DAINTREE_LOG_CONSOLE="${DAINTREE_LOG_CONSOLE:-1}"

echo "▶ Daintree runbook search"
echo "  python: $PY"
echo "  MCP:    http://${HOST:-127.0.0.1}:${PORT:-8080}/v1/daintree/mcp"

exec "$PY" -m daintree_assistant_server

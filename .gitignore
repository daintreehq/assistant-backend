# The local-selector training environment (torch, transformers, CUDA-less but
# still ~2GB). Deliberately SEPARATE from .venv: training deps must never leak
# into the serving dependency set, which takes only numpy/onnxruntime/tokenizers.
.venv-train/

# Distribution
build/
dist/
*.egg-info/

# Temporary / scratch
.tmp/

# Local runbook-learning harness: audit records, proposals, and (when configured to
# a separate overlay dir) generated runbook files. The default edit-in-place mode
# writes to the tracked runbooks dir instead, so those show up in `git diff`.
.daintree/

# Benchmark run outputs (local records, not source)
benchmarks/*/results/

# Testing / tooling caches
.pytest_cache/
.coverage
coverage.xml

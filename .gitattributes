# Git LFS — binary model artifacts for local skill selection.
#
# These are the FINE-TUNED exports that ship in the Docker image. Without these
# rules git stores an ONNX graph as text: it diffs to hundreds of thousands of
# "lines", bloats every clone with the full history of every re-export, and makes
# a routine `git diff` unusable. The base checkpoints are never committed at all —
# they are pulled from HuggingFace by `training/` and only our fine-tuned
# derivatives land here.
*.onnx      filter=lfs diff=lfs merge=lfs -text
*.onnx_data filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text

# The skill embedding table (vectors.npz) ships with the artifact: ~175KB of
# float32 for the build catalog, so the first turn after a deploy does not pay to
# re-embed a catalog that has not changed. Binary, so LFS.
*.npz       filter=lfs diff=lfs merge=lfs -text

# Tokenizer vocabularies ship beside the graphs. tokenizer.json is JSON but is a
# ~700KB generated vocabulary, not source: diffing it is noise.
src/daintree_assistant_server/skills/local/artifacts/**/tokenizer.json filter=lfs diff=lfs merge=lfs -text

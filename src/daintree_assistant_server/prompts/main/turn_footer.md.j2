{% if turn_context %}
---

# Current turn

{% if turn_context.goal %}Current objective: {{ turn_context.goal }}
{% endif %}{% if turn_context.workflow_runs %}Active workflow runs: {{ turn_context.workflow_runs | join(", ") }}
{% endif %}{% if turn_context.async_operations %}Async operations in flight (the runtime is watching these and will wake you when each finishes — do NOT re-run, await, or poll them; async.cancel stops one): {{ turn_context.async_operations | join(", ") }}
{% endif %}{% if turn_context.memories and (turn_context.memories.pinned or turn_context.memories.relevant) %}Memories:
{% if turn_context.memories.pinned %}  Pinned: {{ turn_context.memories.pinned | join(", ") }}
{% endif %}{% if turn_context.memories.relevant %}  Relevant: {{ turn_context.memories.relevant | join(", ") }}
{% endif %}{% endif %}{% if turn_context.resumed_watchers %}Resumed watchers (these were created in a previous session, kept running while the assistant was closed, and are still being supervised — use watcher.list to inspect or watcher.cancel to stop one): {{ turn_context.resumed_watchers | join(", ") }}
{% endif %}{% if turn_context.workflow_state %}Durable workflows — client-owned execution graphs, the durable source of truth for long-running work. Trust these digests over your memory of the conversation and do NOT redo work a workflow already shows as done (no repeat reads, spawns, sends, or polls). If a digest looks stale after a tool result or a wake, call workflow.reconcile. Never invent graph state — when exact state matters, read it with the workflow tools.
{% for wf in turn_context.workflow_state %}- {{ wf.id }} [{{ wf.status }}] {{ wf.goal }}{% if wf.progress %} — {{ wf.progress }}{% endif %}
{% if wf.active_nodes %}  active: {{ wf.active_nodes | join("; ") }}
{% endif %}{% if wf.resources %}  resources: {{ wf.resources | join("; ") }}
{% endif %}{% if wf.blockers %}  blockers: {{ wf.blockers | join("; ") }}
{% endif %}{% if wf.next_action %}  next: {{ wf.next_action }}
{% endif %}{% if wf.last_event %}  last event: {{ wf.last_event }}
{% endif %}{% endfor %}{% endif %}{% endif %}

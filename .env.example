# Local settings for `./dev`. Copy to `.env`; everything here is optional.
#
# The server holds no credential and calls no upstream, so there is nothing
# secret to set.

# development | test | staging | production. staging and production withhold
# startup error detail from /readyz.
ENVIRONMENT=development
LOG_LEVEL=INFO

HOST=127.0.0.1
PORT=8473

# Largest request body accepted, in bytes (default 64 KiB).
# MAX_REQUEST_BYTES=65536

# Daintree Assistant Server — example environment configuration.
# Copy to .env for local development. NEVER commit real secret values.

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Set DAINTREE_LOG_CONSOLE=1 for human-readable logs in a terminal.

# Bind address for `python -m daintree_assistant_server`. Cloud Run injects
# PORT=8080; pick a fixed local dev port your CLI can always target.
HOST=127.0.0.1
PORT=8473

# --- Upstream provider (DeepSeek; OpenAI-compatible) ---
# Models are hardcoded (a product decision; see config.py): the main completion,
# the selector, the utility tasks, and the skill-learning gate use
# deepseek-v4-flash. (The skill builder/improver run on OpenAI GPT-5.5 instead —
# see OPENAI_API_KEY below.) Only the API key and base URL are configurable.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-me
# DeepSeek controls reasoning via a `thinking` object; thinking must be DISABLED
# for the selector's forced tool_choice. Both flags default ON; flip off only for
# a provider/model that rejects the field.
DEEPSEEK_SEND_PROMPT_CACHE_KEY=true
DEEPSEEK_SEND_THINKING=true

# --- Skill-learning provider (OpenAI GPT-5.5) ---
# The skill-learning builder/improver run on OpenAI's GPT-5.5 reasoning model
# (hardcoded in config.py), NOT DeepSeek — a stronger, separate model for the hard
# "write a whole skill" task. Only needed when SKILL_LEARNING_MODE is not "off"
# (local dev); the key then fails readiness if missing. GPT-5.5 is a reasoning model,
# so the adapter sends reasoning_effort + max_completion_tokens and omits temperature.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-me

# --- Main-model thinking ---
# The main /respond call runs WITH reasoning by default (the selector and utility
# tasks always run non-thinking). DeepSeek has no "low" reasoning level — effort only
# meaningfully supports high/max (low/medium map up to high) — so "high" is the floor,
# the lightest thinking available. Set MAIN_THINKING_ENABLED=false to turn it off.
MAIN_THINKING_ENABLED=true
MAIN_REASONING_EFFORT=high

# --- Authentication ---
# In development this is OPTIONAL: leave it unset for unauthenticated local
# access. In production it is REQUIRED (a missing key fails readiness, and the
# server never allows unauthenticated access there).
DAINTREE_API_KEY=replace-me

# --- State signing (HMAC; distinct from API and provider keys) ---
STATE_SIGNING_KEY_CURRENT=replace-me-with-32+-random-bytes
STATE_SIGNING_KID=state-2026-06
# Optional previous key for zero-downtime rotation:
# STATE_SIGNING_KEY_PREVIOUS=...
# STATE_SIGNING_KID_PREVIOUS=state-2026-05
STATE_TOKEN_TTL_SECONDS=604800
STATE_SALT=replace-me

# --- Limits ---
MAX_REQUEST_BYTES=8388608
MAX_TOOLS=128
MAX_ACTIVE_SKILLS=3

# --- Timeouts (seconds) ---
SELECTOR_TIMEOUT_SECONDS=20
MAIN_TIMEOUT_SECONDS=840
UTILITY_TIMEOUT_SECONDS=60

# --- Retries ---
# Every upstream call (main completion, stream open, selector, utility
# tasks) retries transient failures only (5xx, timeouts, rate limits, transport
# errors), and only before any public bytes are emitted. 3 retries = up to 4
# attempts. Note: each attempt gets the full per-call timeout above, so a stuck
# upstream can cost up to (1 + retries) x timeout before failing; lower this if
# that worst case matters more than resilience.
MAX_UPSTREAM_RETRIES=3
# Exponential backoff base; the wait is base * 2**attempt (+ jitter), capped at
# 5s. Set to 0 to retry immediately with no backoff.
RETRY_BACKOFF_BASE_SECONDS=0.25

# --- Policy ---
ALLOW_REMOTE_IMAGE_URLS=false
EXPOSE_DEBUG_SELECTOR_REASON=false

# --- Skill learning (LOCAL DEVELOPMENT ONLY) ---
# A backend-internal harness that watches completed local workflows and writes or
# improves skill files so the catalog "learns". Entirely invisible to the CLI: no
# new wire fields, and the main assistant model is never told it exists — a created
# skill simply appears as a normal dynamic skill load. MUST be off in production:
# an enabled mode fails /readyz there. Leave OFF unless you are iterating on skills.
#   off     — disabled (default)
#   propose — run the gate (DeepSeek) + OpenAI GPT-5.5 builder/improver and write a
#             proposal + audit JSON under SKILL_LEARNING_AUDIT_DIR, but never touch
#             skill files
#   apply   — also write/rewrite the skill file and reload the catalog in place
SKILL_LEARNING_MODE=off
# Where created/improved skills are written. Empty → the packaged skills dir
# (edit-in-place; improvements show up in `git diff`, ready to commit). Set to a
# separate dir (e.g. .daintree/skills) to keep the source tree untouched — the
# catalog then loads packaged skills PLUS that overlay.
SKILL_LEARNING_DIR=
# Per-change audit + proposal JSON records land here (gitignored).
SKILL_LEARNING_AUDIT_DIR=.daintree/skill-learning
# Builder/improver reasoning tier (high | xhigh) — OpenAI GPT-5.5 effort levels.
# The gate stays non-thinking (and runs on DeepSeek).
SKILL_LEARNING_REASONING_EFFORT=high
# Gate verdicts below this confidence never write.
SKILL_LEARNING_MIN_CONFIDENCE=0.75
# Minimum conversation messages before learning is considered (needs prior work).
SKILL_LEARNING_MIN_MESSAGES=3

# --- Optional tracing ---
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Daintree Assistant Server — example environment configuration.
# Copy to .env for local development. NEVER commit real secret values.

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Set DAINTREE_LOG_CONSOLE=1 for human-readable logs in a terminal.

# The commit this build was cut from, reported by /version as `build_sha`. NOT
# something to set by hand: the Dockerfile takes it as a build ARG and bakes it
# into the image (`--build-arg=BUILD_SHA=$COMMIT_SHA` in cloudbuild.yaml), which
# is what lets the release smoke assert that the revision it is about to promote
# is the commit that was pushed. Empty in a local checkout, and correct there.
# BUILD_SHA=

# Bind address for `python -m daintree_assistant_server`. Cloud Run injects
# PORT=8080; pick a fixed local dev port your CLI can always target.
HOST=127.0.0.1
PORT=8473

# --- Upstream provider (Together AI; OpenAI-compatible) ---
# The model is hardcoded (a product decision; see config.py): the main completion
# and every utility task use deepseek-ai/DeepSeek-V4-Flash-0731 on Together AI.
# Runbook selection is LOCAL and makes no upstream call at all.
#
# There is no endpoint-selection policy: Together is a model HOST, not a router,
# so one endpoint serves the model and there is nothing to filter, sort or pin.
# Prefix caching is automatic and org-scoped. Only the key and base URL are
# configurable.
#
# The same weights `context_compact` reached through OpenRouter for months —
# what changed is the host. OpenRouter is a router and this server sends it no
# routing preferences, so its endpoint choice is whatever the default is that
# minute: replaying the 62 real utility-task payloads measured Together at p50
# 1100ms against OpenRouter's 3414ms. Pinning the host IS the latency decision.
TOGETHER_BASE_URL=https://api.together.xyz/v1
# REQUIRED. THE server's upstream credential, funding every turn: callers supply
# no key of their own (see auth.py), so without it /readyz stays 503 and nothing
# can be answered.
TOGETHER_API_KEY=

# --- Second provider (OpenRouter) — OPTIONAL, and unused today ---
# It funded exactly one thing: the `context_compact` utility task, which routed
# to deepseek/deepseek-v4-flash because that was an order of magnitude cheaper
# per input token than the serving model. The serving model IS DeepSeek V4 Flash
# now, so the task came home and NO profile routes here any more.
#
# LEAVING THIS EMPTY IS A VALID DEPLOYMENT — more than valid, it is the expected
# state. It does NOT gate /readyz, and with no profile pointed at it, an empty
# value costs nothing at all. The `_provider_for` mechanism stays because it is
# the seam that made moving a task off the serving model possible in the first
# place.
#
# This is NOT a return to provider routing. There is no endpoint-selection
# policy, no fallback pool and no caller-facing routing preference — those were
# deleted in the move to Cerebras and did not come back. One provider, one model,
# one task.
OPENROUTER_API_KEY=

# --- Thinking ---
# NOTHING IN THIS SERVER THINKS. On Together that IS a flag and it is sent:
# DeepSeek V4 Flash reasons by default, and the unified `reasoning: {"enabled":
# false}` object is honoured (measured — reasoning_tokens drop out of the usage
# block entirely). The ONE exception is the fast-response stage: gpt-oss-120b
# reasons and cannot be told not to, so it is held at Cerebras's `low` floor
# instead (config.FAST_RESPONSE_REASONING_EFFORT). Runbook selection is LOCAL (an
# in-process classifier) and makes no upstream call at all.
# Because max_tokens is shared by reasoning + output, those small-output thinking
# calls add this many tokens of headroom to their caps:
THINKING_HEADROOM_TOKENS=4000

# --- Main-model output shape ---
# The completion budget a turn gets, and the ceiling a caller may request up to.
# They are equal on purpose: the budget is SHARED by prose and tool-call
# arguments, and a tighter default repeatedly cut real multi-spawn tool batches
# off mid-arguments (`finish_reason=length`) — each truncation costing a full
# extra round to re-issue the amputated calls, which is strictly more expensive
# than finishing the generation. Runaway containment is the ceiling's job, not
# the default's.
MAIN_DEFAULT_MAX_TOKENS=8000
MAIN_MAX_TOKENS_CEILING=8000

# The Daintree terminal is ~56 columns. This is the FALLBACK for a client that
# reports no width; the display-context tail block and the output linter both
# resolve through it.
MAIN_TERMINAL_WIDTH=56

# Output linting. The non-streaming path lints the final assistant message
# (pipe-table width, visible <think> leakage, oversized dumps) and LOGS what it
# finds — pure observability. Repair additionally converts an over-width pipe
# table to a per-entity list before returning; it is deterministic, never a model
# call, and streaming is untouched either way.
#
# This is one of the handful of genuinely OPERATIONAL switches (with
# EXPOSE_DEBUG_SELECTOR_REASON and TOOL_PROJECTION_MODE below): its right value
# is whatever production says this week, which is why it is a setting at all when
# model, posture and prompt are hardcoded.
MAIN_OUTPUT_LINT_ENABLED=true
MAIN_OUTPUT_REPAIR_TABLES=false
# A final message larger than this many characters is flagged as an oversized
# dump (the recitation failure mode). Observability only — nothing is truncated.
MAIN_OUTPUT_WARN_CHARS=8000
# The STREAMING hard stop, and a different thing entirely: it kills a live
# generation rather than writing a log line. Deliberately INDEPENDENT of the warn
# width above — coupling them would let a logging tweak change when the server
# hangs up on a model. 0 disables the guard.
MAIN_STREAM_RUNAWAY_CHARS=16000

# --- Authentication ---
# THE DOOR IS OPEN, deliberately and temporarily. There is no inbound API key to
# configure and callers need not send one: the server holds the upstream
# credential above and funds every turn from it, so there is nothing for a bearer
# token to authenticate against yet. A token that IS sent is IGNORED ENTIRELY —
# not parsed, not validated, not rejected — because a CLI mid-migration may still
# be sending an old key, and reading it would forward that key upstream where it
# is rejected under the caller's name. Account authentication IS built — see
# auth.py and the AUTH_MODE block below — but `open` is the shipped default, and
# under it the header is not read for authentication at all. Refusing to look is
# what lets an old client keep working instead of failing confusingly.

# --- State signing (HMAC; nothing to do with any upstream credential) ---
STATE_SIGNING_KEY_CURRENT=replace-me-with-32+-random-bytes
STATE_SIGNING_KID=state-2026-06
# Optional previous key for zero-downtime rotation:
# STATE_SIGNING_KEY_PREVIOUS=...
# STATE_SIGNING_KID_PREVIOUS=state-2026-05
STATE_TOKEN_TTL_SECONDS=604800
STATE_SALT=replace-me

# --- Limits ---
MAX_REQUEST_BYTES=8388608
MAX_TOOLS=128
MAX_ACTIVE_RUNBOOKS=3

# One TOOL DEFINITION, and the shape of the JSON Schema inside it. The whole
# tools array is the largest region of a request (~65% of the deterministic
# fixture), so these bound the pathological single entry rather than the total —
# MAX_TOOLS above bounds the count, MAX_REQUEST_BYTES the body.
# MAX_TOOL_DEFINITION_BYTES=2097152
# MAX_TOOL_SCHEMA_DEPTH=16
# MAX_TOOL_SCHEMA_PROPERTIES=512
# MAX_TOOL_SCHEMA_STRING_BYTES=16384

# The CLIENT-SUPPLIED `result_schema`, which only `terminal_extract_json` accepts
# (services/result_schema.py). Separate from the tool-schema caps above and much
# tighter, because this one is validated per task call rather than per session and
# a caller writes it by hand.
# MAX_RESULT_SCHEMA_BYTES=32768
# MAX_RESULT_SCHEMA_DEPTH=12
# MAX_RESULT_SCHEMA_PROPERTIES=128
# MAX_RESULT_SCHEMA_ENUM=128
# MAX_RESULT_SCHEMA_STRING=4096

# Request SHAPE caps — how MANY of a thing, and how big ONE of them may be. The
# 8 MiB body ceiling does not cover the first: 100,000 two-byte messages is small
# on the wire and expensive in every stage after it. Every default sits far above
# real traffic on purpose — crossing one means a request is MALFORMED, not busy —
# so these are listed for completeness, not as tuning knobs. Reasoning for each
# is in config.py beside the field.
#
# The visible transcript:
# CAP_MESSAGES=2000
# CAP_CONTENT_PARTS=64
# CAP_TOOL_CALLS_PER_MESSAGE=64
# CAP_MESSAGE_TEXT=1048576
# CAP_MESSAGE_TEXT_PART=1048576
# CAP_IMAGES=8
# CAP_IMAGE_ENCODED_BYTES=6291456
#
# Turn options:
# CAP_STOP_SEQUENCES=8
# CAP_STOP_SEQUENCE_BYTES=256
# CAP_PINNED_RUNBOOK_IDS=16
#
# The structured `startup` block:
# CAP_STARTUP_AGENTS=512
# CAP_STARTUP_AGENT_BYTES=16384
# CAP_PROJECT_INSTRUCTIONS=16384
# CAP_GOAL=8192
# CAP_PINNED_MEMORIES=16384
# CAP_RELEVANT_MEMORIES=16384
#
# Live runtime state in the volatile tail:
# CAP_OPEN_TERMINALS=32
# CAP_WATCHERS_COUNT=20
# CAP_WATCHERS_BYTES=4096
# CAP_WORKFLOW_RUNS=24576
# CAP_ASYNC_OPERATIONS=8192
# CAP_WORKFLOW_DIGESTS=5
# CAP_WORKFLOW_STATE_BYTES=16384
# CAP_MCP_SERVERS=32
# CAP_MCP_BLOCK_BYTES=65536
# CAP_DOCS_QUERY=256
# CAP_DOCS_BLOCK_BYTES=16384
# CAP_COMPACTION_BLOCK_BYTES=65536

# NOT configurable, and named here because its absence is confusing otherwise:
# the serving model's CONTEXT WINDOW is hardcoded (config.EXECUTOR_CONTEXT_TOKENS),
# like the model id and the thinking posture. `services/context_budget.py`
# measures every assembled request against it, logs the estimate beside the
# upstream's own prompt_tokens (`turn_usage.estimated_prompt_tokens`), and
# refuses with 413 `context_window_exceeded` only when the input alone clears the
# window — the figure is unverified against the live host, so it is allowed to
# fail a paid turn only where no estimator error could rescue it.

# --- Timeouts (seconds) ---
# SELECTOR_TIMEOUT_SECONDS bounds only the SCRIPTED test-seam selector (tests
# and deterministic benchmarks); production selection is local and bounded by
# the inference pool's own fixed timeout.
SELECTOR_TIMEOUT_SECONDS=8
# Runaway containment on that same test-seam selector, not a spend target: the
# reason-first key order puts runbook_ids LAST in the JSON, so a length
# truncation loses the critical key rather than the tail of an explanation.
SELECTOR_MAX_OUTPUT_TOKENS=800
MAIN_TIMEOUT_SECONDS=840
# Default budget for the small utility tasks (classify, judge, summarize,
# extract). The heavyweight transcript/graph tasks (checkpoint, memory_distill,
# workflow_*) carry their own explicit 60s budget on their TaskProfile.
UTILITY_TIMEOUT_SECONDS=60
# Bounded SEPARATELY from the three budgets above, because they are read budgets
# — the maximum gap between chunks — and a TCP+TLS handshake that never completes
# would otherwise sit under an 840-second one. Connect, write and pool all take
# this value.
UPSTREAM_CONNECT_TIMEOUT_SECONDS=10

# Note what is NOT here: the entitlement lookup's 10-second budget is a
# CROSS-SERVICE number (the website's endpoint holds an 8-second hard total and
# the 2-second margin is transport), so it is hardcoded beside the client as
# `services/entitlement.py::ENTITLEMENT_TIMEOUT_SECONDS` rather than exposed as a
# dial an operator could tighten below the outage fallback it exists to catch.

# --- Retries ---
# THIS SETTING GOVERNS ONE HOP ONLY: backend → Together. Every upstream call
# (main completion, stream open, selector, utility tasks) retries transient
# failures (5xx, timeouts, rate limits, transport errors). On the non-streaming
# path this happens before any public bytes; a STREAMING turn may still retry the
# open/prefetch after the `meta` event has been emitted, but never once a model
# delta has been sent. The normal posture is ONE retry (up to 2 attempts).
#
# THERE IS A SECOND, LEGITIMATE RETRY LAYER on the OTHER hop: CLI → backend
# (cli/internal/backend/retry.go — up to 10 attempts inside a 2-minute window,
# sized to ride out a backend restart). These are different networks and
# different failure modes, so they coexist by design; the CLI does not replay a
# deterministic failure or a turn that has already streamed visible tokens. See
# docs/PROVIDER_POLICY.md for how the two layers compose.
#
# Each attempt gets the full per-call timeout above. Note what that timeout IS: an
# httpx READ budget — the maximum gap between chunks — not a total wall clock, with
# connect/write/pool bounded separately. So "(1 + retries) x timeout" is a rough
# worst case for a fully stalled upstream, NOT a ceiling on turn duration: a
# response that keeps trickling bytes resets the read clock indefinitely. A real
# end-to-end deadline is separate work.
# A valid upstream Retry-After is AUTHORITATIVE and replaces the computed backoff
# entirely (including 0, i.e. retry at once). One LARGER than 10s abandons the
# retry instead of waiting — a live turn cannot absorb that pause.
MAX_UPSTREAM_RETRIES=1
# Exponential backoff base. The wait is base * 2**attempt, capped at 5s, PLUS up
# to one extra `base` of jitter — so the real ceiling is 5s + base (5.25s at the
# default). Set to 0 to retry immediately with no backoff.
RETRY_BACKOFF_BASE_SECONDS=0.25


# --- Policy ---
ALLOW_REMOTE_IMAGE_URLS=false
EXPOSE_DEBUG_SELECTOR_REASON=false

# --- Upstream request dumping (LOCAL DEVELOPMENT ONLY) ---
# When set, every upstream request body is written there as numbered
# pretty-printed JSON — the prompt-cache forensics tool (diff two dumps to find
# the byte where "identical" requests diverge). Contains FULL prompts; a set
# value in production fails /readyz.
# DAINTREE_DUMP_UPSTREAM_DIR=

# --- Runbook overlay directory (LOCAL DEVELOPMENT ONLY) ---
# A scratch directory of runbook files merged OVER the packaged catalog: a new id
# is added, a colliding id replaces the packaged runbook. Point it at a directory,
# edit a runbook there while the server runs, then pick the edit up without a
# restart:
#     curl -X POST http://127.0.0.1:8473/v1/daintree/runbooks/reload
# That route exists ONLY while this is set and the environment is not hardened.
# A set value in production fails /readyz.
# DAINTREE_RUNBOOKS_OVERLAY_DIR=


# --- Runbook-aware tool projection ---
# Tool schemas are the largest single region of a request. Projection narrows them
# to the active runbooks' declared needs. Against the pinned 79.3 KiB inventory:
# 20.8 KiB on a runbook-less turn, 46.8 KiB with a runbook and its foundation loaded.
#
#   disabled  compute nothing, send the full inventory
#   shadow    compute and log what it WOULD send, still send everything (default)
#   enforced  send the projection, whenever every safety gate passes
#
# Enforcement fails open to the full inventory on a degraded selector, a projection
# that could not be built, an empty or inconsistent proposal, or a pinned/unanswered
# tool the proposal lost. Sub-agent turns are held out.
#
# TO ROLL BACK, no code deployment required — but set it where a RELEASE keeps
# it. The deploy hands Cloud Run an `--env-vars-file`, which replaces the whole
# environment, so a `gcloud run services update --update-env-vars` reverts on the
# next push to `main` and the projection comes back on with nothing to show it
# did. The substitution survives:
#   gcloud builds triggers run deploy-main \
#     --substitutions=_TOOL_PROJECTION_ROLLOUT_PERCENT=0   halt, keep measuring
#     --substitutions=_TOOL_PROJECTION_MODE=disabled       stop computing it
# For an emergency where waiting on a build is the wrong trade, the direct
# service update is still right — just follow it with the substitution, or the
# next release undoes it.
TOOL_PROJECTION_MODE=shadow
# Session-stable: a conversation stays in one arm for its whole life. SET THIS
# BEFORE flipping the mode — `enforced` at the default 100 is every session at once.
# Staged rollout: 1 -> 5 -> 25 -> 50 -> 100.
TOOL_PROJECTION_ROLLOUT_PERCENT=100

# --- Training traces (a SEPARATE plane from operational logging) ---
# Operational logs (structlog/Cloud Logging) are metadata-only and stay that way.
# This is the other plane: exact content, restricted access, written for replay
# and later model training. They are NOT two verbosity levels of one system.
#
# `off` is the default and the correct one for any deployment that has not
# deliberately opted in: there is no consent record for it to check. An account
# model exists now, but it does not help here — `AccountContext` carries a
# pseudonymous subject hash, an OAuth client and a plan, and nothing in it says
# whether that subject agreed to have their turns kept for training. Under the
# shipped `AUTH_MODE=open` there is not even a subject: every request is the
# anonymous principal. So consent remains something a person obtains out of
# band, and full-content capture stays refused outright in production and
# staging rather than gated on a flag somebody could set by mistake.
#
#   off             record nothing
#   metadata        the trace skeleton — ids, timings, hashes, usage — no content
#   full_internal   exact content. CONTROLLED INTERNAL TESTING ONLY, and refused
#                   outright in production/staging (fails /readyz)
TRACE_CAPTURE_MODE=off

#   null | filesystem | gcs
# `filesystem` is forbidden in production/staging (container-local storage for
# content-bearing data). Its directory may contain FULL user content — it is
# gitignored, and must never go into a diagnostic bundle.
TRACE_SINK=null
# TRACE_FILESYSTEM_DIR=.tmp/traces
# TRACE_GCS_BUCKET=
TRACE_GCS_PREFIX=raw/v1

# Its OWN key — never the state-signing key and never the state salt. Session and
# turn ids are HMACed under it and never stored raw. Sharing a key across two
# purposes makes a compromise of either a compromise of both, and rotating one
# would silently re-pseudonymise every trace, splitting one subject into two
# identities in the middle of a corpus. Required for full_internal.
# TRACE_IDENTITY_KEY=

# The bounded wait before the terminal `done`. Uploads run concurrently with
# generation, so the normal path has nothing left to flush; this budget is for the
# abnormal one. A user does not hold a connection open for a training record.
TRACE_FINAL_FLUSH_GRACE_SECONDS=0.5
TRACE_MAX_PENDING_BYTES=33554432
TRACE_MAX_EVENT_BYTES=8388608

# --- Fast response (the Cerebras preamble stage) ---
# ALWAYS ON. Two or three sentences saying what the request is taken to MEAN,
# written by a second INTERNAL model running AT THE SAME TIME as the executor and
# shown while it is still opening. Not a second product: a request still targets
# `daintree-assistant` and no caller can select between the two calls.
#
# There is no mode and no rollout percentage. Both existed to get the feature into
# production carefully; that decision is made, and leaving the dials in would keep
# the product's shape configurable in exactly the way this file's own rule forbids.
# Turning it off is a code change now, which is the honest description of what it
# would be.
#
# The executor never sees the text, which is what lets the two run concurrently:
# its request is byte-identical whether the preamble succeeded, was declined, or
# failed outright. Anything arriving after the executor's first visible byte is
# dropped unshown.

# Short and absolute, and there is NO retry — though no longer because the
# executor is waiting on it. Nothing is behind this call. The WINDOW is what is
# short: a line is shown only until the executor's first visible byte, so a call
# still running past this point is buying an answer that can no longer be used.
FAST_RESPONSE_TIMEOUT_SECONDS=3

# REQUIRED, like TOGETHER_API_KEY. Readiness fails without it: a missing key would
# otherwise present as "the preamble never appears", which is indistinguishable
# from the feature working and the model choosing to say nothing.
CEREBRAS_API_KEY=
# Defaults to https://api.cerebras.ai/v1. In production/staging it must point at
# that origin: it receives the server's own credential.
# CEREBRAS_BASE_URL=
# The model is HARDCODED (config.FAST_RESPONSE_MODEL = gpt-oss-120b), like the
# executor's, and so is its reasoning effort: that model reasons and Cerebras
# defaults it to `medium`, so `low` is pinned beside the id rather than left to
# the wire. There is no "off" to pin.

# Account-gated at Cerebras. Off unless someone has confirmed it is enabled — an
# unadvertised parameter is a needless 400 on a path whose value is being fast.
CEREBRAS_PROMPT_CACHE_ENABLED=false

# ---------------------------------------------------------------------------
# Account authentication (Supabase Auth as an OAuth 2.1 authorization server)
# ---------------------------------------------------------------------------
#
# NONE of these is a secret. The issuer, the JWKS URL and the public OAuth client
# id are published to any caller by GET /v1/daintree/auth/config, which is what
# stops a client hardcoding a Supabase project that then drifts from the backend.
# They are deployment IDENTITY: which project mints our tokens, which client the
# CLI registers as. What a valid token must LOOK like — the audience, the signing
# algorithms, the clock skew, what each client may do — is policy with one right
# answer, and is hardcoded beside the verifier (services/supabase_auth.py) rather
# than configured here.
#
#   open      the Authorization header is not read at all; every request is served
#             anonymously and the server funds it. Today's shipped posture, and
#             the default, so a deployment that sets nothing does not move.
#   observe   verifies a token that IS present and records the outcome, leaving
#             authorization unchanged: an observed identity grants nothing, denies
#             nothing, and a request with no token or a bad one is served exactly
#             as `open` would serve it. Evidence before enforcement. Not free — a
#             well-formed token costs a verification and, on a cold cache, a JWKS
#             fetch — so watch latency as well as the outcome counts.
#   enforce   requires a verified token. A credential we reject is a 401/403
#             from the account family; being UNABLE to check one — no verifier,
#             a JWKS outage — is a retryable 503 `auth_dependency_unavailable`,
#             never a fake logout.
#
# All three are implemented and tested. `enforce` establishes that a token is
# genuine and unexpired; it does NOT yet establish that the session behind it
# still exists, because nothing reaches back into a minted JWT — so a logout
# leaves the signature valid until `exp`. See TODO.md before enforcing on anyone
# real.
#
# `observe` and `enforce` require the five manifest values below (the issuer, the
# JWKS URL, the two OAuth endpoints and the client id) — readiness fails
# otherwise, because a deployment checking tokens must also be able to tell a
# client how to obtain one. The two browser links are OPTIONAL in every mode: a
# deployment with working sign-in and no subscription page still publishes a
# usable manifest, and withholding the whole manifest over a missing link would
# suppress sign-in to enforce a nicety. The two session-policy values have
# defaults and are not part of the requirement either.
#
# ENVIRONMENT and AUTH_MODE are independent. There is deliberately no fourth
# `staging` auth mode: a staging deployment is ENVIRONMENT=staging in whichever
# posture the rollout has reached. The staged rollout for
# assistant.daintree.org is
#
#   ENVIRONMENT=staging
#   browser account/payment links on staging.daintree.org
#   AUTH_MODE=open or observe to begin with
#   AUTH_MODE=enforce only after an end-to-end sign-in has been validated
#
# and the mode moves by a config-only revision, which is the reason it is a
# setting at all.
AUTH_MODE=open

# The exact issuer, ending in /auth/v1. Compared for equality against the token's
# `iss`, so a token minted by a different Supabase project is refused.
# SUPABASE_AUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
# Validated against the SAME rules the CLI applies to the published manifest, so
# a value it would refuse fails readiness here instead of failing a user's login:
#
#   - the issuer must name supabase.co or daintree.org (or a subdomain). The trust
#     anchor is pinned rather than configured — discovery supplies the project,
#     the client and the endpoints, but not which company issues our tokens.
#   - its path must end in /auth/v1: it is compared for equality against the
#     token's `iss`, so the bare project URL would match nothing ever minted.
#   - the authorize, token and JWKS endpoints must share the issuer's origin AND
#     sit under its path. A half-edited configuration pointing one of them at the
#     previous project is exactly what the origin half catches; the path half
#     stops a sibling handler on the issuer's own host from standing in for it.
#   - in production/staging all of them must be https and name a publicly
#     reachable host. Outside production, plain http is accepted only on a
#     literal loopback ADDRESS (127.0.0.1, ::1) — never on a name, not even
#     `localhost`, which resolves wherever the host's name lookup points it and
#     so does not establish that there is no network to intercept.
#   - percent-escapes are refused in the path of the issuer and the three OAuth
#     endpoints: every way of reading one differs between implementations, and a
#     real OAuth path never needs it.
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_OAUTH_AUTHORIZE_URL=https://<project-ref>.supabase.co/auth/v1/oauth/authorize
# SUPABASE_OAUTH_TOKEN_URL=https://<project-ref>.supabase.co/auth/v1/oauth/token
# At most 200 characters of A-Za-z0-9-_.~ with no surrounding whitespace: it goes
# into a URL query string and into the client's credential store. Whitespace is
# REJECTED rather than trimmed — the client trims what it receives and validates
# the trimmed copy, so trimming here too would validate one value and publish
# another.
# SUPABASE_OAUTH_CLIENT_ID=

# There is deliberately no redirect-URI setting. The callback is registered with
# the identity provider and compiled into the client, which compares the published
# value against its own for equality — so a value this server could vary could only
# ever be wrong. It is a constant in config.py, pinned against the client's own
# definition by a test.

# Where a client sends someone to manage or buy a plan. OPTIONAL — sign-in works
# without them. Pinned to daintree.org (or
# a subdomain) for the same reason the issuer is, and it is the sharper of the two:
# these open in the user's BROWSER under the assistant's own recommendation, so a
# free choice here is a phishing page with the product vouching for it.
# DAINTREE_ACCOUNT_URL=https://staging.daintree.org/account
# DAINTREE_SUBSCRIBE_URL=https://staging.daintree.org/subscribe

# Published so a client can schedule its own refresh. These MIRROR the Supabase
# project's session settings — this server neither sets nor enforces them — so
# they are the one pair here that can drift silently. Change them together.
# AUTH_ACCESS_TOKEN_SECONDS=3600
# AUTH_SESSION_MAX_AGE_SECONDS=2592000

# ---- Account entitlement (does this account have a plan?) -------------------
#
# Staged SEPARATELY from AUTH_MODE, because identity and entitlement are two
# questions with two failure modes: merging the rollouts would mean a billing
# outage presenting to a user as a signed-out session.
#
#   off       paid routes never ask. Today's behaviour and the default.
#   observe   paid routes resolve the verdict and log it, and never refuse on it.
#             The mirror of AUTH_MODE=observe. Not free: a paid request costs one
#             lookup against the website, so watch latency as well as the counts.
#   enforce   `access: granted` is required. A known missing or inactive plan is
#             the typed 402 family; an answer we could not obtain is the typed
#             503, never a guess.
#
# observe and enforce BOTH require AUTH_MODE=enforce — under any other mode every
# request is the anonymous principal, which has no account to ask about — and a
# configuration that does not satisfy that fails readiness rather than quietly
# reverting to `off`.
ENTITLEMENT_MODE=off

# The website's authenticated entitlement endpoint. The CALLER's Supabase bearer
# authenticates this lookup, so there is no service key to configure here and
# nothing secret about the value.
#
# Pinned to daintree.org (or a subdomain) for the same reason the account links
# are, and more sharply: this request forwards the caller's account credential, so
# a host that could be chosen freely is a credential sent to a stranger. It must
# also carry no userinfo, query string or fragment — the verified subject is the
# only input to the lookup. Outside staging and production a literal loopback
# http:// URL is accepted so a local website is developable.
#
# The PATH is pinned too, and to exactly one spelling:
#
#   /api/assistant/entitlement          (no trailing slash)
#
# A host answers "is this us"; only the route answers "is this the endpoint that
# is supposed to receive a forwarded bearer" — every other path on the same site
# is a place that credential could be delivered instead. Every near miss is
# refused rather than corrected: a trailing slash, a doubled slash, a different
# case, a percent-escape anywhere in the path. Nothing is rewritten, because
# quietly changing a security-relevant destination is worse than refusing an
# ambiguous one. The loopback carve-out relaxes the host and the scheme and never
# the route, so a local website is at
# http://127.0.0.1:<port>/api/assistant/entitlement.
#
# Validated in EVERY mode, including `off`: a malformed value is not dormant, it
# is what GET /v1/daintree/account will use the moment somebody sets a mode.
# DAINTREE_ENTITLEMENT_URL=https://staging.daintree.org/api/assistant/entitlement

.venv/
.venv-train/
.git/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
infra/
*.egg-info/
.env
# Every .env sibling too — `.env.bak.<epoch>` backups carry the same live
# secrets as `.env` itself, and a pattern that only names the canonical
# file ships them into the build context on the first `cp .env .env.bak`.
.env.*
*.pem
*.key
*.p12
*.pfx
*service-account*.json
credentials.json
application_default_credentials.json
*.log
.DS_Store

# The runtime stage only copies pyproject.toml, README.md, requirements.lock and
# src/, so everything below is context the daemon transfers and never reads.
# tests/ and benchmarks/ are read by the `qualify` stage (the release gate), but
# a benchmark's saved results are not an input to it.
benchmarks/*/results/
archive/
training/
docs/
build/
.tmp/
.claude/
.codex/
.mcp.json
.daintree/
.github/
uv.lock
# Local leftovers from the retired package path must not enter a build context.
src/daintree_assistant_server/skills/
